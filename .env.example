# ============================================================
#  SMU Monitor - Configuration Template
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to git.
# ============================================================

# --- Your SMU login ---
SMU_USERNAME=your_student_number
SMU_PASSWORD=your_password

# --- ntfy push notifications (primary, free, recommended) ---
# 1. Install the ntfy app on your phone: https://ntfy.sh
# 2. Subscribe to your topic in the app
# 3. Keep the topic secret — it acts like a password
NTFY_TOPIC=your-secret-topic-name
NTFY_SERVER=https://ntfy.sh

# --- Gmail alerts (optional secondary channel) ---
# Requires a Gmail App Password (not your real password):
# https://myaccount.google.com/apppasswords
GMAIL_SENDER=your_email@gmail.com
GMAIL_APP_PASS=xxxx xxxx xxxx xxxx
GMAIL_RECIPIENT=your_email@gmail.com

# --- Check interval in seconds (min: 60, max: 3600) ---
# 120 = every 2 minutes
CHECK_INTERVAL=120

# --- Active window (monitor only runs between these times) ---
# Format: HH:MM in 24-hour time.
# ACTIVE_TZ must be a valid IANA timezone name.
# Kosovo is in Europe/Belgrade (UTC+1 winter, UTC+2 summer).
ACTIVE_START=08:00
ACTIVE_END=22:00
ACTIVE_TZ=Europe/Belgrade
